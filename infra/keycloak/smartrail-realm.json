        },
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "smartrail-api",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "smartrail-identity-admin",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "dev-only-change-me",
      "description": "The API creates, reads and deletes passenger accounts with this service account. DEVELOPMENT secret; replace outside development."
    }
