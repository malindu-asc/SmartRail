{
  "realm": "smartrail",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "sslRequired": "none",
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      {
        "name": "passenger",
        "description": "Public traveller using the passenger app"
      },
      {
        "name": "driver",
        "description": "Train driver using the driver app"
      },
      {
        "name": "controller",
        "description": "Network controller operating the service"
      },
      {
        "name": "scheduler",
        "description": "Scheduler maintaining timetables, assignments and special services"
      },
      {
        "name": "admin",
        "description": "System administrator managing users, roles and devices"
      },
      {
        "name": "inspector",
        "description": "Ticket inspector spot-checking tickets in the staff app"
      },
      {
        "name": "station_master",
        "description": "Station master working on their own station only"
      }
    ]
  },
  "clients": [
    {
      "clientId": "smartrail-api",
      "enabled": true,
      "bearerOnly": true
    },
    {
      "clientId": "smartrail-web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:*",
        "https://localhost:*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        },
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "smartrail-api",
            "access.token.claim": "true"
          }
        },
        {
          "name": "stations",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "station_codes",
            "claim.name": "stations",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "smartrail-mobile",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
