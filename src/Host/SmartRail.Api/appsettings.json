{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Outbox": {
    "IntervalMilliseconds": 1000,
    "BatchSize": 20,
    "MaxAttempts": 5
  },
  "Network": {
    "TimeZone": "Asia/Colombo"
  },
  "AllowedHosts": "*"
}
