{
  "name": "smartrail-e2e",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "End-to-end flows for the SmartRail web consoles, run in a real browser against the running Docker Compose stack.",
  "scripts": {
    "install:browser": "playwright install chromium",
    "e2e": "playwright test",
    "e2e:critical": "playwright test tests/critical-flows.spec.ts",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^24.0.0",
    "typescript": "~5.7.0"
  }
}
